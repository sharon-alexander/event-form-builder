# ──────────────────────────────────────────────────────────────────────────────
# Multi-location event form builder — environment variables
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (CMS backend) ───────────────────────────────────────────────────
# Powers the admin dashboard and the form's runtime config. Find these under
# Project Settings -> API in your Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Edge Functions (set via `supabase secrets set`, not in .env) ──────────────
# No hash in this URL — PKCE breaks if redirectTo contains #/…
# ADMIN_SET_PASSWORD_URL=https://yoursite.com/admin
# Dev: http://localhost:5173/admin

# ── Shared ───────────────────────────────────────────────────────────────────
# Public site URL (optional). Used for gallery image paths in production builds.
# Defaults to https://event-form-builder.vercel.app when not set.
# VITE_SITE_URL=https://event-form-builder.vercel.app
